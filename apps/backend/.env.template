STORE_NAME=Youjaymharah
SUPPORT_EMAIL=support@youjaymharah.com
STOREFRONT_URL=http://localhost:8000
ADMIN_URL=http://localhost:9000

# Redis (Upstash or similar, standard TCP URL, e.g. rediss://default:<token>@<host>:6379).
# When set, Redis replaces the in-memory defaults for FIVE things: the event
# bus, the workflow engine, the cache, distributed locks, and admin sessions
# (sessions come from projectConfig.redisUrl -- without it admins are logged
# out by every deploy). Leave empty in local dev to run on the in-memory
# defaults; everything still works, just per-process and not across restarts.
#
# The instance must have eviction disabled (maxmemory-policy noeviction).
# BullMQ warns loudly otherwise, and an evicted key is a silently dropped job
# -- which here means an order confirmation email that never sends. Prefer a
# single-region instance in the same region as the app: BullMQ holds blocking
# connections open, and cross-region latency shows up as ETIMEDOUT.
REDIS_URL=
# Optional. Namespaces every Medusa key, so several environments can share one
# Redis instance without colliding. Defaults to "youjaymharah:".
REDIS_PREFIX=
