# Cloudflare R2 (S3-compatible). From the Cloudflare dashboard:
#   S3_ENDPOINT  https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#                NOTE: do NOT append the bucket name — the SDK adds it, and
#                objects otherwise upload one level deep and 404 on S3_FILE_URL.
#   S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY  R2 > Manage R2 API Tokens (secret shown once)
#   S3_BUCKET    the bucket name you chose
#   S3_FILE_URL  public base URL: the bucket's pub-<hash>.r2.dev address, or a
#                custom domain. Prefer a custom domain in production; r2.dev is
#                rate-limited by Cloudflare.
#   S3_REGION    always "auto" for R2
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_FILE_URL=
S3_REGION=auto


# Google sign-in for customers. All three are required together: set them and
# the provider switches on, leave any blank and the store stays email/password
# only. From Google Cloud Console > APIs & Services > Credentials > OAuth
# client ID (type: Web application).
#   GOOGLE_CALLBACK_URL  the storefront page Google returns the customer to,
#                        e.g. https://<storefront>/auth/google/callback (locally
#                        http://localhost:8000/auth/google/callback). Register
#                        this exact URL as an Authorised redirect URI in Google,
#                        and make sure the storefront origin is in AUTH_CORS.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL=

