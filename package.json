{
  "name": "youjaymharah-store",
  "private": false,
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "backend:seed": "turbo seed --filter=@youjaymharah/backend",
    "backend:dev": "turbo dev --filter=@youjaymharah/backend",
    "storefront:dev": "turbo dev --filter=@youjaymharah/storefront",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.19.0",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "turbo": "^2.0.14"
  }
}
