# Public entry point. DOMAIN and ACME_EMAIL come from infra/.env:
#
#   {$DOMAIN}         storefront
#   www.{$DOMAIN}     redirect to the storefront
#   api.{$DOMAIN}     Medusa server: Store and Admin APIs, auth, webhooks
#   admin.{$DOMAIN}   the dashboard's static files; it calls api.{$DOMAIN}
#
# Certificates are issued and renewed automatically (HTTP-01 on port 80).

{
	email {$ACME_EMAIL}

	servers {
		# Cloudflare's published ranges (https://www.cloudflare.com/ips/). A
		# request from one of these may name the real client in
		# CF-Connecting-IP; any other peer is the client itself. Harmless when
		# Cloudflare is not in front: no request then comes from these ranges,
		# so the header is never believed. Re-check the list once a year.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

(upstream) {
	# Medusa trusts exactly one proxy hop (Express "trust proxy" = 1), so it
	# reads the last X-Forwarded-For entry as the client. Replacing the header
	# with the single resolved address keeps rate limits per shopper rather
	# than per Cloudflare edge, and nothing a client sends survives.
	header_up X-Forwarded-For {client_ip}

	# A deploy restarts Medusa, which is down while it boots. Holding requests
	# that fail to connect for up to 30 s turns most of that into a slow
	# response instead of a 502. Only connection failures are retried, so a
	# request is never sent twice.
	lb_try_duration 30s
	lb_try_interval 1s
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

{$DOMAIN} {
	import security_headers
	encode zstd gzip
	reverse_proxy storefront:8000 {
		import upstream
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

api.{$DOMAIN} {
	import security_headers
	encode zstd gzip
	reverse_proxy medusa-server:9000 {
		import upstream
	}
}

admin.{$DOMAIN} {
	import security_headers
	header X-Frame-Options "DENY"
	reverse_proxy admin:8080
}
