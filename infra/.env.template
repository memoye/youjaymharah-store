# Compose-level settings for this VPS. Copy to .env next to compose.yaml.
# Contains no secrets; application secrets go in backend.env.

# The storefront's apex domain. Caddy serves DOMAIN, www.DOMAIN (redirect),
# api.DOMAIN and admin.DOMAIN, and requests their certificates.
DOMAIN=example.com

# Let's Encrypt account contact: expiry and problem notices go here.
ACME_EMAIL=ops@example.com

# Must equal the GitHub Environment deploying here (deploy.yml checks it).
# Also the suffix of this deployment's admin and storefront image tags.
ENVIRONMENT=production

# ghcr.io/<owner>/<repo>, lowercase.
IMAGE_PREFIX=ghcr.io/your-org/youjaymharah-store

# Written by deploy.sh. Leave empty on a new host.
BACKEND_TAG=
PREVIOUS_BACKEND_TAG=
STOREFRONT_TAG=
PREVIOUS_STOREFRONT_TAG=
